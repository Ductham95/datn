// =====================================================
// PRISMA SCHEMA - Hệ thống giám sát chất lượng không khí
// =====================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [timescaledb, postgis, uuid_ossp(map: "uuid-ossp")]
}

model User {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  username      String   @unique @db.VarChar(100)
  password_hash String   @db.VarChar(255)
  role          String   @default("user") @db.VarChar(20)
  created_at    DateTime @default(now()) @db.Timestamptz()

  @@map("users")
}

model Gateway {
  id            String       @id @db.VarChar(50)
  name          String       @db.VarChar(100)
  location_desc String?      @db.VarChar(255)
  status        String       @default("offline") @db.VarChar(20)
  last_seen     DateTime?    @db.Timestamptz()
  sensor_nodes  SensorNode[]

  @@map("gateways")
}

model SensorNode {
  id            String                            @id @db.VarChar(50)
  gateway_id    String?                           @db.VarChar(50)
  name          String                            @db.VarChar(100)
  geom          Unsupported("geometry(Point,4326)")?
  status        String                            @default("active") @db.VarChar(20)
  battery_level Int                               @default(100)
  lora_rssi     Int?
  last_seen     DateTime?                         @db.Timestamptz()

  gateway Gateway? @relation(fields: [gateway_id], references: [id], onDelete: Cascade)

  @@map("sensor_nodes")
}

/// Lưu ý: Đây là TimescaleDB Hypertable. 
/// Hypertable + Retention Policy + Continuous Aggregate được thiết lập qua init.sql
model Measurement {
  time        DateTime @db.Timestamptz()
  node_id     String   @db.VarChar(50)
  pm25        Float?
  pm10        Float?
  co2         Int?
  tvoc        Int?
  temperature Float?
  humidity    Float?

  @@id([time, node_id])
  @@map("measurements")
}

/// Cấu hình ngưỡng cảnh báo hệ thống (singleton row, id = 'default')
model AlertConfig {
  id                String   @id @default("default") @db.VarChar(50)
  pm25_warn         Float    @default(35.4)
  pm25_danger       Float    @default(55.4)
  pm10_warn         Float    @default(154)
  pm10_danger       Float    @default(254)
  co2_warn          Int      @default(1000)
  co2_danger        Int      @default(2000)
  tvoc_warn         Int      @default(500)
  tvoc_danger       Int      @default(1000)
  temp_min          Float    @default(15)
  temp_max          Float    @default(40)
  sampling_interval Int      @default(300)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz()

  @@map("alert_configs")
}

/// Bảng lưu cảnh báo tự động (vượt ngưỡng / mất kết nối)
model Alert {
  id           Int      @id @default(autoincrement())
  node_id      String   @db.VarChar(50)
  type         String   @db.VarChar(30)
  severity     String   @db.VarChar(10)
  metric       String?  @db.VarChar(20)
  value        Float?
  threshold    Float?
  message      String   @db.VarChar(500)
  acknowledged Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz()

  @@index([node_id])
  @@index([created_at])
  @@index([acknowledged])
  @@map("alerts")
}

/// Bảng ghi log hành động quản trị (audit trail)
model AuditLog {
  id         Int      @id @default(autoincrement())
  user_id    String   @db.Uuid
  username   String   @db.VarChar(100)
  action     String   @db.VarChar(20)
  resource   String   @db.VarChar(50)
  resource_id String? @db.VarChar(100)
  details    String?  @db.Text
  ip_address String?  @db.VarChar(45)
  created_at DateTime @default(now()) @db.Timestamptz()

  @@index([user_id])
  @@index([created_at])
  @@index([resource])
  @@map("audit_logs")
}
