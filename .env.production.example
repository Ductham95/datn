# =====================================================
# Environment Variables - Production (TEMPLATE)
# =====================================================
# Copy file này thành .env.production và điền giá trị thật
# KHÔNG commit .env.production lên Git!

# === PostgreSQL Container (POSTGRES_* dùng bởi Docker image) ===
POSTGRES_USER=datn_admin
POSTGRES_PASSWORD=<mật_khẩu_mạnh>
POSTGRES_DB=air_quality_db

# === Backend App ===
DB_HOST=db
DB_PORT=5432
DB_USER=datn_admin
DB_PASSWORD=<mật_khẩu_mạnh_giống_trên>
DB_NAME=air_quality_db
DATABASE_URL=postgresql://datn_admin:<mật_khẩu_mạnh>@db:5432/air_quality_db?schema=public

# Server
PORT=3000
NODE_ENV=production

# Domain
DOMAIN=datn.thamnguyen.dev

# Provisioning (thay đổi key này)
PROVISION_KEY=<provision_key_mới>

# Weather API
WEATHER_API_KEY=<openweathermap_api_key>
