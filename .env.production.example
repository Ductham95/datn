# =====================================================
# Environment Variables - Production (TEMPLATE)
# =====================================================
# Copy file này thành .env.production và điền giá trị thật
# KHÔNG commit .env.production lên Git!

# Database
DB_HOST=db
DB_PORT=5432
DB_USER=datn_admin
DB_PASSWORD=<mật_khẩu_mạnh_thay_đổi>
DB_NAME=air_quality_db
DATABASE_URL=postgresql://datn_admin:<mật_khẩu_mạnh_thay_đổi>@db:5432/air_quality_db?schema=public

# Server
PORT=3000
NODE_ENV=production

# Domain
DOMAIN=datn.thamnguyen.dev

# Provisioning (thay đổi key này)
PROVISION_KEY=<provision_key_mới>

# Weather API
WEATHER_API_KEY=<openweathermap_api_key>
